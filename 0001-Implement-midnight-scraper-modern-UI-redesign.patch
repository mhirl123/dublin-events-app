+  const [selectedEvent, setSelectedEvent] = useState<Event | null>(null)
+  const [isLoading, setIsLoading] = useState(false)
+
+  const genres = ['All', 'Theater', 'Music', 'Comedy', 'Festival', 'Workshop']
+
