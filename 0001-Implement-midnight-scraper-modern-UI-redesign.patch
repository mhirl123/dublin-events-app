+/**
+ * Midnight Scraper - Scheduled Job for Daily Event Updates
+ * Runs at midnight UTC (or configurable time)
+ * Scrapes all 6 Dublin venues for real event data and images
+ */
+
+import { AbbeyTheatreScraperV2, GaietyTheatreScraperV2, VicarStreetScraperV2, WhelansScraperV2, CraicDenScraperV2, ThreeArenaScraperV2 } from './sites/EnhancedTheaterScraper'
+
+interface ScraperResult {
+  venue: string
+  eventCount: number
+  success: boolean
+  error?: string
+  timestamp: string
+}
+
+/**
+ * Execute all scrapers and return results
+ */
+export async function runMidnightScrape(): Promise<{
+  success: boolean
+  message: string
+  timestamp: string
+  results: ScraperResult[]
+  summary: {
+    totalVenues: number
+    successfulVenues: number
+    failedVenues: number
+    totalEvents: number
+  }
+}> {
+  const startTime = new Date()
+  console.log(`\n🌙 Midnight Scraper Started at ${startTime.toISOString()}`)
+
+  const scrapers = [
+    new AbbeyTheatreScraperV2(),
+    new GaietyTheatreScraperV2(),
+    new VicarStreetScraperV2(),
+    new WhelansScraperV2(),
+    new CraicDenScraperV2(),
+    new ThreeArenaScraperV2(),
+  ]
+
+  const results: ScraperResult[] = []
+  let totalEvents = 0
+  let successCount = 0
+  let failureCount = 0
+
+  for (const scraper of scrapers) {
+    const venueName = scraper['theaterName']
+    try {
+      console.log(`\n⏳ Scraping ${venueName}...`)
+      const events = await scraper.scrape()
+
+      results.push({
+        venue: venueName,
+        eventCount: events.length,
+        success: true,
+        timestamp: new Date().toISOString(),
+      })
+
+      totalEvents += events.length
+      successCount++
+
+      console.log(
+        `✅ ${venueName}: ${events.length} events scraped and saved to database`
+      )
+    } catch (error) {
+      failureCount++
+      results.push({
+        venue: venueName,
+        eventCount: 0,
+        success: false,
+        error: error instanceof Error ? error.message : String(error),
+        timestamp: new Date().toISOString(),
+      })
+
+      console.error(
+        `❌ ${venueName} failed: ${error instanceof Error ? error.message : error}`
+      )
+    }
+  }
+
+  const endTime = new Date()
+  const durationSeconds = (endTime.getTime() - startTime.getTime()) / 1000
+
+  const summary = {
+    totalVenues: scrapers.length,
+    successfulVenues: successCount,
+    failedVenues: failureCount,
+    totalEvents: totalEvents,
+  }
+
+  const message =
+    failureCount === 0
+      ? `✅ All ${successCount} venues scraped successfully! Found ${totalEvents} events.`
+      : `⚠️ Scraping complete: ${successCount} succeeded, ${failureCount} failed. Found ${totalEvents} events.`
+
+  console.log(`\n📊 Scraper Summary:`)
+  console.log(`   Total Venues: ${summary.totalVenues}`)
+  console.log(`   Successful: ${successCount}`)
+  console.log(`   Failed: ${failureCount}`)
+  console.log(`   Total Events Found: ${totalEvents}`)
+  console.log(`   Duration: ${durationSeconds.toFixed(2)}s`)
+  console.log(`\n🌙 Midnight Scraper Completed at ${endTime.toISOString()}\n`)
+
+  return {
+    success: failureCount === 0,
+    message,
+    timestamp: endTime.toISOString(),
+    results,
+    summary,
+  }
+}
+
+// Export for CLI execution
+if (require.main === module) {
+  runMidnightScrape()
+    .then((result) => {
+      console.log('\nFinal Result:', JSON.stringify(result, null, 2))
+      process.exit(result.success ? 0 : 1)
+    })
+    .catch((error) => {
+      console.error('Fatal error:', error)
+      process.exit(1)
+    })
+}
