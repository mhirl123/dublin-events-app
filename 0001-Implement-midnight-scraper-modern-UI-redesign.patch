+import { NextRequest, NextResponse } from 'next/server'
+import { AbbeyTheatreScraperV2, GaietyTheatreScraperV2, VicarStreetScraperV2, WhelansScraperV2, CraicDenScraperV2, ThreeArenaScraperV2 } from '@/lib/scrapers/sites/EnhancedTheaterScraper'
+
+export const dynamic = 'force-dynamic'
+
+/**
+ * Scraper API Endpoint
+ * Trigger with: POST /api/scrape?key=secret-key
+ * Returns: Count of events scraped from each venue
+ */
+export async function POST(request: NextRequest) {
+  try {
+    const key = new URL(request.url).searchParams.get('key')
+    const secretKey = process.env.SCRAPER_SECRET_KEY || 'dev-scraper-key'
+
+    // Verify authorization
+    if (key !== secretKey) {
+      return NextResponse.json(
+        { error: 'Unauthorized - invalid scraper key' },
+        { status: 401 }
+      )
+    }
+
+    console.log('🌐 Starting Dublin Events Scraper...')
+    const startTime = Date.now()
+
+    // Initialize scrapers for each venue
+    const scrapers = [
+      new AbbeyTheatreScraperV2(),
+      new GaietyTheatreScraperV2(),
+      new VicarStreetScraperV2(),
+      new WhelansScraperV2(),
+      new CraicDenScraperV2(),
+      new ThreeArenaScraperV2(),
+    ]
+
+    const results: {
+      venue: string
+      events: number
+      success: boolean
+      error?: string
+    }[] = []
+    let totalEvents = 0
+    let successCount = 0
+    let failureCount = 0
+
+    // Run each scraper
+    for (const scraper of scrapers) {
+      try {
+        console.log(`⏳ Scraping ${scraper['theaterName']}...`)
+        const events = await scraper.scrape()
+        results.push({
+          venue: scraper['theaterName'],
+          events: events.length,
+          success: true,
+        })
+        totalEvents += events.length
+        successCount++
+        console.log(
+          `✅ ${scraper['theaterName']} complete: ${events.length} events`
+        )
+      } catch (error) {
+        failureCount++
+        results.push({
+          venue: scraper['theaterName'],
+          events: 0,
+          success: false,
+          error: error instanceof Error ? error.message : String(error),
+        })
+        console.error(
+          `❌ ${scraper['theaterName']} failed:`,
+          error instanceof Error ? error.message : error
+        )
+      }
+    }
+
+    const duration = Date.now() - startTime
+
+    return NextResponse.json({
+      status: 'success',
+      message: `Scraping complete: ${successCount} venues successful, ${failureCount} failed`,
+      timestamp: new Date().toISOString(),
+      summary: {
+        totalVenues: scrapers.length,
+        successfulVenues: successCount,
+        failedVenues: failureCount,
+        totalEventsScraped: totalEvents,
+        durationMs: duration,
+      },
+      results: results,
+    })
+  } catch (error) {
+    console.error('Scraper API error:', error)
+    return NextResponse.json(
+      {
+        error: 'Scraping failed',
+        message: error instanceof Error ? error.message : 'Unknown error',
+      },
+      { status: 500 }
+    )
+  }
+}
+
+/**
+ * GET endpoint for manual scraper trigger (also supports GET for simplicity)
+ */
+export async function GET(request: NextRequest) {
+  // For GET requests, just call POST with the same parameters
+  return POST(request)
+}
