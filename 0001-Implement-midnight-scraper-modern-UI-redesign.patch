+
+  const getImageSrc = (imageUrl?: string) => {
+    if (!imageUrl) {
+      return 'data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%22400%22 height=%22300%22%3E%3Crect fill=%22%23f0f0f0%22 width=%22400%22 height=%22300%22/%3E%3Ctext x=%2250%25%22 y=%2250%25%22 text-anchor=%22middle%22 dy=%22.3em%22 fill=%22%23999%22%3ENo Image%3C/text%3E%3C/svg%3E'
+    }
+    return imageUrl
+  }
+
+  const formatPrice = (min?: number, max?: number) => {
+    if (!min && !max) return 'Price TBA'
+    if (min && !max) return `€${min}`
+    if (min && max && min === max) return `€${min}`
+    return `€${min || 0}–€${max || 'TBA'}`
+  }
+
+  return (
+    <div className="min-h-screen bg-gradient-to-br from-purple-300 via-pink-300 to-purple-200">
+      {/* Header */}
+      <header className="bg-white bg-opacity-10 backdrop-blur-md sticky top-0 z-50 border-b border-white border-opacity-20">
+        <div className="max-w-7xl mx-auto px-4 py-3 flex items-center justify-between">
+          <h1 className="text-2xl font-bold text-white">
+            🎭 Dublin Events
+          </h1>
+          <button className="w-8 h-8 rounded-full bg-white text-purple-600 font-bold flex items-center justify-center hover:bg-opacity-90">
+            ⚙️
+          </button>
+        </div>
+      </header>
+
+      <div className="max-w-7xl mx-auto px-4 py-8">
+        <div className="grid grid-cols-1 lg:grid-cols-5 gap-8">
+          {/* Left: Event Gallery */}
+          <div className="lg:col-span-2">
+            {/* Location Card */}
+            <div className="bg-gradient-to-br from-pink-400 to-purple-500 rounded-3xl p-6 text-white mb-6 shadow-lg">
+              <p className="text-sm opacity-90 mb-2">📍 Looking for me</p>
+              <h2 className="text-3xl font-bold mb-6">Dublin, Ireland</h2>
+
+              {/* Search Bar */}
+              <div className="bg-white rounded-2xl p-1 flex items-center mb-6">
+                <input
+                  type="text"
+                  placeholder="Search events"
+                  value={searchQuery}
+                  onChange={(e) => setSearchQuery(e.target.value)}
+                  className="flex-1 px-4 py-2 bg-transparent text-gray-800 placeholder-gray-400 outline-none"
+                />
+                <button className="p-2 text-purple-600 hover:bg-purple-50 rounded-xl">
+                  🔍
+                </button>
+              </div>
+
+              {/* Upcoming Events Count */}
+              <p className="text-sm font-semibold">
+                {filteredEvents.length} Upcoming Events
+              </p>
+            </div>
+
+            {/* Event Mosaic Grid */}
+            <div className="grid grid-cols-2 gap-4">
+              {filteredEvents.slice(0, 6).map((event) => (
+                <div
+                  key={event.id}
+                  onClick={() => setSelectedEvent(event)}
+                  className={`rounded-2xl overflow-hidden cursor-pointer transform transition-all hover:scale-105 shadow-md ${
+                    selectedEvent?.id === event.id ? 'ring-4 ring-pink-400' : ''
+                  }`}
+                >
+                  <div className="relative w-full h-40 bg-gradient-to-br from-purple-300 to-pink-300">
+                    {event.imageUrl ? (
