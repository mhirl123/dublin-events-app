+import { BaseScraper, ScrapedEvent } from '../BaseScraper'
+import * as cheerio from 'cheerio'
+
+/**
+ * Enhanced Theater Scraper with Image URL Extraction
+ * Specifically configured for Dublin venues
+ */
+export class EnhancedTheaterScraper extends BaseScraper {
+  protected theaterName: string
+  protected theaterUrl: string
+  protected eventContainerSelector: string
+  protected imageSelector: string
+
+  constructor(
+    theaterName: string,
+    theaterUrl: string,
+    eventContainerSelector: string,
+    imageSelector: string
+  ) {
+    super(theaterName, theaterUrl, 'cheerio')
+    this.theaterName = theaterName
+    this.theaterUrl = theaterUrl
+    this.eventContainerSelector = eventContainerSelector
+    this.imageSelector = imageSelector
+  }
+
+  async scrape(): Promise<ScrapedEvent[]> {
+    console.log(
+      `[${this.theaterName}] Starting scrape from ${this.theaterUrl}...`
+    )
+    const events: ScrapedEvent[] = []
+
+    try {
+      // Fetch the page
+      const response = await fetch(`${this.theaterUrl}/whats-on`, {
+        headers: {
+          'User-Agent':
+            'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36',
+        },
+      })
+
+      if (!response.ok) {
+        throw new Error(`HTTP ${response.status}`)
+      }
+
+      const html = await response.text()
+      const $ = cheerio.load(html)
+
+      // Parse events from the page
+      $(this.eventContainerSelector).each((_index, element) => {
+        try {
+          const $event = $(element)
+
+          // Extract title - try multiple selectors
+          const title =
+            $event.find('h2, h3, a[data-title], [data-title]').first().text().trim() ||
+            $event.find('.title, .name, .event-name, .event-title').first().text().trim() ||
+            $event.attr('data-event-title') ||
+            ''
+
+          if (!title) {
+            console.warn(
+              `[${this.theaterName}] Skipping event with no title in container`
+            )
+            return
+          }
+
+          // Extract image URL - try multiple selectors and attributes
+          let imageUrl: string | undefined
+          const $img =
+            $event.find(this.imageSelector).first() ||
+            $event.find('img').first() ||
+            $event.find('[data-image]').first()
+
+          if ($img.length > 0) {
+            imageUrl =
+              $img.attr('src') ||
+              $img.attr('data-src') ||
+              $img.attr('data-image') ||
+              $img.css('background-image')?.match(/url\(['"]?([^'"]+)['"]?\)/)?.[1]
+
+            // Ensure absolute URL
+            if (imageUrl && !imageUrl.startsWith('http')) {
+              imageUrl = `${this.theaterUrl}${imageUrl.startsWith('/') ? '' : '/'}${imageUrl}`
+            }
+          }
+
+          // Extract date - try multiple selectors and attributes
+          let dateStr = ''
+          dateStr =
+            $event.attr('data-date') ||
+            $event.find('[data-date]').attr('data-date') ||
+            $event.find('.date, .event-date, [data-date]').first().text().trim() ||
+            $event.find('time').attr('datetime') ||
+            ''
+
+          if (!dateStr) {
+            console.warn(
+              `[${this.theaterName}] Skipping event "${title}" with no date`
+            )
+            return
+          }
+
+          // Parse date
+          let eventDate: Date
+          try {
+            eventDate = this.parseDate(dateStr)
+          } catch {
+            console.warn(
+              `[${this.theaterName}] Could not parse date: ${dateStr} for event "${title}"`
+            )
+            return
+          }
+
+          // Extract price
+          const priceStr =
+            $event.find('.price, .event-price, .ticket-price').first().text().trim() ||
+            ''
+          const ticketPrice = this.parsePrice(priceStr)
+
+          // Extract ticket URL
+          let ticketUrl =
+            $event.find('a[href*="ticket"], a[href*="book"], a.get-tickets').attr('href') ||
+            ''
+          if (ticketUrl && !ticketUrl.startsWith('http')) {
+            ticketUrl = `${this.theaterUrl}${ticketUrl.startsWith('/') ? '' : '/'}${ticketUrl}`
+          }
+
+          // Extract description
+          const description =
+            $event.find('.description, .event-description, p').first().text().trim() ||
+            ''
+
+          events.push({
+            title,
+            description: description || undefined,
+            dateStart: eventDate,
+            genre: 'Theater',
+            ticketPriceMin: ticketPrice,
+            ticketUrl: ticketUrl || undefined,
+            imageUrl: imageUrl,
+            venueName: this.theaterName,
+            sourceUrl: `${this.theaterUrl}/whats-on`,
+            sourceEventId: `${this.theaterName.toLowerCase()}-${title.toLowerCase().replace(/\s+/g, '-')}`,
+          })
+
+          console.log(
+            `[${this.theaterName}] Parsed event: "${title}" on ${eventDate.toLocaleDateString()}${imageUrl ? ' (with image)' : ''}`
+          )
+        } catch (error) {
+          console.error(
+            `[${this.theaterName}] Error parsing event:`,
+            error instanceof Error ? error.message : error
+          )
+        }
+      })
+
+      console.log(`[${this.theaterName}] Found ${events.length} events`)
+    } catch (error) {
+      console.error(`[${this.theaterName}] Scrape failed:`, error)
+      throw error
+    }
+
+    // Save to database
+    if (events.length > 0) {
+      await this.saveEvents(events)
+    }
+
+    await this.cleanup()
+    return events
+  }
+
+  protected parseDate(dateStr: string): Date {
+    // Try parsing as ISO format first
+    const date = new Date(dateStr)
+    if (!isNaN(date.getTime())) {
+      return date
+    }
+
+    // Try parsing common formats: "15 Sept 2026", "Sept 15, 2026", "15-09-2026", etc.
+    // This is a simple implementation; a more robust parser would be needed for production
+    throw new Error(`Invalid date: ${dateStr}`)
+  }
+
+  protected parsePrice(priceStr: string): number | undefined {
+    if (!priceStr) return undefined
+    // Extract numeric value from strings like "€25", "€25-50", "From €25"
+    const match = priceStr.match(/€?([\d.]+)/)
+    return match ? parseFloat(match[1]) : undefined
+  }
+}
+
+// Pre-configured scraper for Abbey Theatre
+export class AbbeyTheatreScraperV2 extends EnhancedTheaterScraper {
+  constructor() {
+    super(
+      'Abbey Theatre',
+      'https://www.abbeytheatre.ie',
+      '.production-grid-item, [data-event], .event-card, .show-item', // Try multiple common selectors
+      'img[src*="content/uploads"], img.event-image, picture img, .image img'
+    )
+  }
+}
+
+// Additional enhanced scrapers
+export class GaietyTheatreScraperV2 extends EnhancedTheaterScraper {
+  constructor() {
+    super(
+      'Gaiety Theatre',
+      'https://www.gaietytheatre.ie',
+      '.performance, .event, [data-event]',
+      'img, [data-image]'
+    )
+  }
+}
+
+export class VicarStreetScraperV2 extends EnhancedTheaterScraper {
+  constructor() {
+    super(
+      'Vicar Street',
+      'https://www.vicarstreet.com',
+      '.event-listing, .show, [data-event]',
+      'img, .image-container img'
+    )
+  }
+}
+
+export class WhelansScraperV2 extends EnhancedTheaterScraper {
+  constructor() {
+    super(
+      'Whelans',
+      'https://www.whelanslive.com',
+      '.event, .show, .event-item, [data-event]',
+      'img, [data-image], picture img'
+    )
+  }
+}
+
+export class CraicDenScraperV2 extends EnhancedTheaterScraper {
+  constructor() {
+    super(
+      'Craic Den Comedy Club',
+      'https://www.craicdencomedyclub.com',
+      '.event, .show, .comedy-night, [data-event]',
+      'img, [data-image]'
+    )
+  }
+}
+
+export class ThreeArenaScraperV2 extends EnhancedTheaterScraper {
+  constructor() {
+    super(
+      '3 Arena',
+      'https://www.3arena.ie',
+      '.event, .concert, [data-event], .performance',
+      'img, [data-image], .hero-image'
+    )
+  }
+}
